# ===================================
# PERFORMANCE & ACCESSIBILITY FLAGS
# ===================================

# Performance Features
FEATURE_CRITICAL_CSS=false
FEATURE_WEBP_IMAGES=true
FEATURE_LAZY_LOADING=true
FEATURE_CODE_SPLITTING=true
FEATURE_RESOURCE_HINTS=true
FEATURE_FRAGMENT_CACHE=true
FEATURE_CDN_ASSETS=false
FEATURE_SERVICE_WORKER=true
FEATURE_WEB_VITALS=true
FEATURE_BROTLI=false

# Accessibility Features
FEATURE_SKIP_LINKS=true
FEATURE_ARIA_LABELS=true
FEATURE_FOCUS_TRAP=true
FEATURE_HIGH_CONTRAST=false
FEATURE_SR_ANNOUNCER=true
FEATURE_KEYBOARD_NAV=true

# Experimental Features
FEATURE_HTTP3=false
FEATURE_EARLY_HINTS=false
FEATURE_PRIORITY_HINTS=false
FEATURE_VIEW_TRANSITIONS=false

# CDN Configuration
CDN_ENABLED=false
CDN_URL=
CDN_ASSETS_DOMAIN=
CDN_IMAGES_DOMAIN=

# Cache TTL (seconds)
CACHE_TTL_LANDING=3600
CACHE_TTL_POSTS=1800
CACHE_TTL_INDICATORS=3600
CACHE_TTL_CORE_VALUES=7200
CACHE_TTL_MENU=3600
CACHE_TTL_FOOTER=3600

# Image Optimization
IMAGE_FORMAT_AVIF=true
IMAGE_FORMAT_WEBP=true
IMAGE_QUALITY_AVIF=80
IMAGE_QUALITY_WEBP=85
IMAGE_QUALITY_JPEG=90
IMAGE_MAX_WIDTH=1920
IMAGE_LAZY_THRESHOLD=0.01

# Third Party Scripts
GA_ENABLED=true
FB_PIXEL_ENABLED=true
TAWK_TO_ENABLED=true
GOOGLE_TRANSLATE_ENABLED=true

# Third Party Delays (ms)
DELAY_ANALYTICS=1500
DELAY_TAWK_TO=2500
DELAY_TRANSLATE=4000
